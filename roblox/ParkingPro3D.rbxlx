]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">LevelBuilder</string><ProtectedString name="Source"><![CDATA[-- Construye un nivel (o la ciudad) a partir de GameData, con su esquina de referencia en `origin`.
-- Devuelve { folder, obstacles, target (Part o nil), targetHW, targetHL, startCF, coins = { Part } }.
local Shared = script.Parent
local Config = require(Shared.Config)
local CarBuilder = require(Shared.CarBuilder)

local S = Config.SCALE
local LevelBuilder = {}

local function newPart(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do p[k] = v end
	p.Parent = parent
	return p
end

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- data: un nivel de GameData.LEVELS o GameData.CITY. city = true para la ciudad.
function LevelBuilder.build(data, origin, parent, city)
	local root = folder(data.name, parent)
	local obstacles = folder("Obstacles", root)
	local decor = folder("Decor", root)
	local b = data.bounds
	local W, L = (b.maxX - b.minX) * S, (b.maxZ - b.minZ) * S
	local center = origin + Vector3.new((b.minX + b.maxX) / 2 * S, 0, (b.minZ + b.maxZ) / 2 * S)

	-- Suelo: césped alrededor y asfalto (u hormigón en la ciudad) dentro del recinto.
	newPart(decor, {
		Name = "Grass", Size = Vector3.new(W + 260, 1, L + 260), CFrame = CFrame.new(center - Vector3.new(0, 0.55, 0)),
		Color = Color3.fromRGB(79, 138, 58), Material = Enum.Material.Grass,
	})
	newPart(decor, {
		Name = "Floor", Size = Vector3.new(W + 4, 1, L + 4), CFrame = CFrame.new(center - Vector3.new(0, 0.5, 0)),
		Color = city and Color3.fromRGB(185, 182, 174) or (data.indoor and Color3.fromRGB(70, 72, 76) or Color3.fromRGB(85, 88, 92)),
		Material = city and Enum.Material.Concrete or Enum.Material.Asphalt,
	})

	if data.roads then
		for _, r in ipairs(data.roads) do
			newPart(decor, {
				Name = "Road", Size = Vector3.new(r.w * S, 0.2, r.l * S), CFrame = CFrame.new(origin + Vector3.new(r.x * S, -0.09, r.z * S)),
				Color = Color3.fromRGB(62, 64, 68), Material = Enum.Material.Asphalt, CanCollide = false,
			})
		end
	end

	for _, ln in ipairs(data.lines) do
		newPart(decor, {
			Name = "Line", Size = Vector3.new(ln.w * S, 0.05, ln.l * S),
			CFrame = CarBuilder.faceCF(origin, ln.x, ln.z, ln.a, 0.03),
			Color = ln.color == "yellow" and Color3.fromRGB(245, 197, 24) or Color3.fromRGB(242, 242, 242),
			Material = Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false, CanTouch = false,
		})
	end

	for _, o in ipairs(data.obstacles) do
		local t = o.type
		if t == "wall" then
			local h = (o.h or 1.1) * S
			local cf = CarBuilder.faceCF(origin, o.x, o.z, o.a, h / 2)
			newPart(obstacles, { Name = "Wall", Size = Vector3.new(o.hw * 2 * S, h, o.hl * 2 * S), CFrame = cf, Color = Color3.fromRGB(168, 164, 154), Material = Enum.Material.Concrete })
			newPart(decor, { Name = "WallCap", Size = Vector3.new(o.hw * 2 * S + 0.05, 0.3, o.hl * 2 * S + 0.05), CFrame = cf + Vector3.new(0, h / 2, 0), Color = Color3.fromRGB(242, 194, 0), CanCollide = false, CanQuery = false })
		elseif t == "car" then
			local car = CarBuilder.build(o.model, { parked = true, color = CarBuilder.hexToColor(o.color) })
			car:PivotTo(CarBuilder.faceCF(origin, o.x, o.z, o.a, car.PrimaryPart.Position.Y))
			car.Parent = obstacles
		elseif t == "cone" then
			local pos = origin + Vector3.new(o.x * S, 0, o.z * S)
			local up = CFrame.Angles(0, 0, math.rad(90))
			newPart(obstacles, { Name = "Cone", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.72 * S, 0.4 * S, 0.4 * S), CFrame = CFrame.new(pos + Vector3.new(0, 0.36 * S, 0)) * up, Color = Color3.fromRGB(255, 90, 0) })
			newPart(decor, { Name = "ConeBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12 * S, 0.42 * S, 0.42 * S), CFrame = CFrame.new(pos + Vector3.new(0, 0.45 * S, 0)) * up, Color = Color3.new(1, 1, 1), CanCollide = false, CanQuery = false })
		elseif t == "pillar" then
			local pos = origin + Vector3.new(o.x * S, 0, o.z * S)
			newPart(obstacles, { Name = "Pillar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4 * S, o.r * 2 * S, o.r * 2 * S), CFrame = CFrame.new(pos + Vector3.new(0, 1.7 * S, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(201, 197, 187), Material = Enum.Material.Concrete })
			newPart(decor, { Name = "PillarBand", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.45 * S, o.r * 2 * S + 0.1, o.r * 2 * S + 0.1), CFrame = CFrame.new(pos + Vector3.new(0, 0.25 * S, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(242, 194, 0), CanCollide = false, CanQuery = false })
		elseif t == "building" then
			local h = o.h * S
			local cf = CarBuilder.faceCF(origin, o.x, o.z, o.a or 0, h / 2)
			newPart(obstacles, { Name = "Building", Size = Vector3.new(o.hw * 2 * S, h, o.hl * 2 * S), CFrame = cf, Color = CarBuilder.hexToColor(o.color), Material = Enum.Material.Concrete })
			-- franjas de ventanas en cada planta
			for floorY = 3 * S, h - 2 * S, 3 * S do
				newPart(decor, { Name = "Windows", Size = Vector3.new(o.hw * 2 * S + 0.2, 1.2 * S, o.hl * 2 * S + 0.2), CFrame = CarBuilder.faceCF(origin, o.x, o.z, o.a or 0, floorY), Color = Color3.fromRGB(59, 74, 92), Material = Enum.Material.Glass, Reflectance = 0.2, CanCollide = false, CanQuery = false })
			end
		end
	end

	local result = { folder = root, obstacles = obstacles, coins = {} }
	local st = data.start
	result.startCF = CarBuilder.faceCF(origin, st.x, st.z, st.a, 0)

	-- Plaza objetivo: superficie amarilla y un cartel flotante.
	if data.target then
		local t = data.target
		local spot = newPart(root, {
			Name = "Target", Size = Vector3.new(t.hw * 2 * S, 0.06, t.hl * 2 * S), CFrame = CarBuilder.faceCF(origin, t.x, t.z, t.a, 0.04),
			Color = Color3.fromRGB(255, 212, 0), Material = Enum.Material.Neon, Transparency = 0.55, CanCollide = false, CanQuery = false, CanTouch = false,
		})
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(150, 46)
		gui.StudsOffset = Vector3.new(0, 3 * S, 0)
		gui.AlwaysOnTop = true
		gui.Parent = spot
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "▼ APARCA AQUÍ"
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 212, 0)
		label.TextStrokeTransparency = 0.3
		label.Parent = gui
		result.target = spot
		result.targetHW = t.hw * S
		result.targetHL = t.hl * S
	end

	-- Monedas (ciudad)
	if data.coins then
		local coins = folder("Coins", root)
		for i, c in ipairs(data.coins) do
			local coin = newPart(coins, {
				Name = "Coin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15 * S, 1.1 * S, 1.1 * S),
				CFrame = CFrame.new(origin + Vector3.new(c.x * S, 1 * S, c.z * S)) * CFrame.Angles(0, math.rad(90), 0),
				Color = Color3.fromRGB(255, 200, 61), Material = Enum.Material.Neon, CanCollide = false, CanTouch = false,
			})
			coin:SetAttribute("CoinId", i)
			result.coins[i] = coin
		end
	end

	return result
end

return LevelBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Physics</string><ProtectedString name="Source"><![CDATA[-- Física del coche (misma que la versión web, en metros y m/s).
-- Roblox mueve y gira la pieza; aquí se calcula qué velocidad y giro debe tener en cada momento.
-- Estado c: v (hacia delante), vl (lateral, + = izquierda), steer (ángulo de ruedas), gear (1 o -1).
-- inp: throttle 0..1, brake 0..1, steer -1..1 (+ = izquierda), handbrake bool.
local Physics = {}

local function clamp(x, lo, hi)
	if x < lo then return lo end
	if x > hi then return hi end
	return x
end
Physics.clamp = clamp

local function sign(x)
	if x > 0 then return 1 elseif x < 0 then return -1 end
	return 0
end

function Physics.step(c, inp, s, dt)
	local sp = math.abs(c.v)
	local drifting = inp.handbrake and sp > 4
	local target = clamp(inp.steer, -1, 1) * s.maxSteer
	-- A velocidad, los neumáticos no dan más agarre lateral que `grip`: el coche subvira.
	if sp > 1 then
		local lim = math.atan((s.grip * (drifting and 2.2 or 1) * s.wb) / (sp * sp))
		target = clamp(target, -lim, lim)
	end
	local rate = (s.steerRate / (1 + sp / 14)) * dt
	c.steer = c.steer + clamp(target - c.steer, -rate, rate)

	-- Motor: empuja con fuerza al salir y pierde empuje cerca de la velocidad máxima.
	local v = c.v
	if inp.throttle > 0 then
		local top = c.gear > 0 and s.maxSpeed or s.maxReverse
		local moving = 0
		if sign(v) == c.gear then moving = math.min(1, sp / top) end
		v = v + c.gear * s.accel * inp.throttle * (1 - 0.75 * moving * moving) * dt
	end
	local dec = 0.6 + 0.0035 * v * v
	if inp.brake > 0 then dec = dec + s.brake * inp.brake end
	if inp.handbrake then dec = dec + s.brake * 0.55 end
	local dv = dec * dt
	if math.abs(v) <= dv then v = 0 else v = v - sign(v) * dv end
	c.v = clamp(v, -s.maxReverse, s.maxSpeed)
	c.braking = inp.brake > 0 or inp.handbrake

	-- Giro alrededor del eje trasero: el centro se mueve de lado a (wb/2)·yaw.
	-- Con el freno de mano a velocidad las ruedas traseras se sueltan (derrape).
	local yaw = (c.v / s.wb) * math.tan(c.steer)
	if drifting then yaw = yaw * 1.4 end
	local vlTarget = s.wb / 2 * yaw
	local grip = 60
	if drifting then grip = 1.6 elseif sp > 1 then grip = 30 end
	c.vl = c.vl + (vlTarget - c.vl) * (1 - math.exp(-grip * dt))
	c.slip = math.abs(c.vl - vlTarget)
	c.yaw = yaw
end

-- Marcha y revoluciones (para el sonido y el marcador).
function Physics.drivetrain(d, e, v, throttle, dt)
	local sp = math.abs(v)
	local g = d.gear
	while g < #e.gears and sp > e.gears[g] * 0.9 do g = g + 1 end
	while g > 1 and sp < e.gears[g - 1] * 0.55 do g = g - 1 end
	d.gear = g
	local target = e.idle + (e.red - e.idle) * math.min(1, sp / e.gears[g])
	if sp < 0.5 then target = e.idle + throttle * (e.red - e.idle) * 0.3 end
	d.rpm = d.rpm + (target - d.rpm) * math.min(1, dt * 7)
end

-- ¿Está el rectángulo del coche dentro de la plaza y alineado con ella?
-- carCF: CFrame del coche; spotCF: CFrame de la plaza; tamaños en studs (medio ancho / medio largo).
function Physics.parkedIn(carCF, carHW, carHL, spotCF, spotHW, spotHL)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local corner = carCF * Vector3.new(sx * carHW, 0, sz * carHL)
			local lp = spotCF:PointToObjectSpace(corner)
			if math.abs(lp.X) > spotHW or math.abs(lp.Z) > spotHL then return false end
		end
	end
	local d = math.abs(carCF.LookVector:Dot(spotCF.LookVector))
	return d > math.cos(0.22)
end

return Physics
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000007"><Properties><string name="Name">Cars</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX00000009"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000008"><Properties><string name="Name">ParkingServer</string><ProtectedString name="Source"><![CDATA[-- Servidor de Parking Pro 3D: partidas guardadas, compras, recompensas validadas,
-- niveles privados de cada jugador, ciudad compartida con monedas y panel de admin.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("ParkingShared")
local Config = require(Shared.Config)
local GameData = require(Shared.GameData)
local CarBuilder = require(Shared.CarBuilder)
local LevelBuilder = require(Shared.LevelBuilder)
local Physics = require(Shared.Physics)

local S = Config.SCALE

-- ---------- Comunicación con los jugadores ----------
local remotes = Instance.new("Folder")
remotes.Name = "ParkingRemotes"
local request = Instance.new("RemoteFunction")
request.Name = "Request"
request.Parent = remotes
local profileChanged = Instance.new("RemoteEvent")
profileChanged.Name = "ProfileChanged"
profileChanged.Parent = remotes
local coinTaken = Instance.new("RemoteEvent")
coinTaken.Name = "CoinTaken"
coinTaken.Parent = remotes
remotes.Parent = ReplicatedStorage

if not ReplicatedStorage:FindFirstChild("Cars") then
	local cars = Instance.new("Folder")
	cars.Name = "Cars"
	cars.Parent = ReplicatedStorage
end

-- ---------- Ambiente ----------
Lighting.ClockTime = 14
Lighting.Brightness = 2.5
Lighting.OutdoorAmbient = Color3.fromRGB(150, 155, 165)
Lighting.GlobalShadows = true

-- ---------- Ciudad compartida ----------
local carsFolder = Instance.new("Folder")
carsFolder.Name = "PlayerCars"
carsFolder.Parent = workspace
local levelsFolder = Instance.new("Folder")
levelsFolder.Name = "PlayerLevels"
levelsFolder.Parent = workspace

local city = LevelBuilder.build(GameData.CITY, Vector3.new(), workspace, true)
city.folder.Name = "City"
local spawn = Instance.new("SpawnLocation")
spawn.Name = "CitySpawn"
spawn.Anchored = true
spawn.Size = Vector3.new(8, 1, 8)
spawn.CFrame = CFrame.new(8 * S, -0.4, 8 * S)
spawn.Transparency = 0.5
spawn.Color = Color3.fromRGB(255, 180, 0)
spawn.Neutral = true
spawn.Parent = city.folder

-- ---------- Partidas guardadas ----------
local store = DataStoreService:GetDataStore(Config.DATASTORE_NAME)
local profiles = {}
local states = {}

local function defaultProfile()
	return {
		coins = Config.START_COINS, owned = { "sedan" }, car = "sedan", color = "#d62828",
		stars = {}, tuning = {}, parts = {}, god = false,
	}
end

local function contains(list, value)
	for _, v in ipairs(list) do
		if v == value then return true end
	end
	return false
end

local function isAdmin(player)
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then return true end
	if game:GetService("RunService"):IsStudio() then return true end
	return contains(Config.ADMIN_USER_IDS, player.UserId)
end

local function publicProfile(player)
	local p = profiles[player]
	if not p then return nil end
	return {
		coins = p.coins, owned = p.owned, car = p.car, color = p.color, stars = p.stars,
		tuning = p.tuning, parts = p.parts, god = p.god, admin = isAdmin(player),
	}
end

local function changed(player)
	local p = profiles[player]
	if not p then return end
	local ls = player:FindFirstChild("leaderstats")
	if ls and ls:FindFirstChild("Monedas") then ls.Monedas.Value = p.coins end
	profileChanged:FireClient(player, publicProfile(player))
end

local function save(player)
	local p = profiles[player]
	if not p then return end
	local ok, err = pcall(function()
		store:SetAsync("u_" .. player.UserId, p)
	end)
	if not ok then warn("No se pudo guardar la partida de " .. player.Name .. ": " .. tostring(err)) end
end

local function load(player)
	local data
	local ok, err = pcall(function()
		data = store:GetAsync("u_" .. player.UserId)
	end)
	if not ok then warn("No se pudo cargar la partida (¿API Services desactivado en Studio?): " .. tostring(err)) end
	local p = defaultProfile()
	if type(data) == "table" then
		for k, v in pairs(data) do p[k] = v end
	end
	return p
end

-- ---------- Coches ----------
local slots = {}

local function setCharacterVisible(character, visible)
	if not character then return end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			if visible then
				d.Transparency = d:GetAttribute("OriginalTransparency") or d.Transparency
			else
				if d:GetAttribute("OriginalTransparency") == nil then d:SetAttribute("OriginalTransparency", d.Transparency) end
				d.Transparency = 1
			end
		elseif d:IsA("Decal") then
			d.Transparency = visible and 0 or 1
		end
	end
end

local function despawn(player)
	local st = states[player]
	if not st then return end
	if st.car then st.car:Destroy() end
	if st.level then st.level.folder:Destroy() end
	if st.slot then slots[st.slot] = nil end
	states[player] = nil
	local character = player.Character
	if character then
		setCharacterVisible(character, true)
		local hum = character:FindFirstChildOfClass("Humanoid")
		if hum then hum.Sit = false end
		task.defer(function()
			if character.Parent then character:PivotTo(spawn.CFrame + Vector3.new(0, 4, 0)) end
		end)
	end
end

local function spawnCar(player, cf)
	local p = profiles[player]
	local key = p.car
	local tune = p.tuning[key] or {}
	local car = CarBuilder.build(key, {
		color = CarBuilder.hexToColor(p.color), rims = tune.rims, height = tune.height, neon = tune.neon,
	})
	car.Name = player.Name .. "_" .. key
	car:SetAttribute("Owner", player.UserId)
	local lift = car.PrimaryPart.Position.Y + 0.3
	car:PivotTo(cf + Vector3.new(0, lift, 0))
	car.Parent = carsFolder
	car.PrimaryPart:SetNetworkOwner(player)
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if hum then
		car.Seat:Sit(hum)
		setCharacterVisible(character, false)
	end
	return car
end

local function freeSlot()
	local i = 1
	while slots[i] do i = i + 1 end
	return i
end

local function starsOf(p, i)
	return p.stars[tostring(i)] or 0
end

local function startLevel(player, index)
	local p = profiles[player]
	local lv = GameData.LEVELS[index]
	if not lv then return { ok = false, error = "Ese nivel no existe" } end
	if index > 1 and starsOf(p, index - 1) == 0 and not isAdmin(player) then
		return { ok = false, error = "Completa el nivel anterior" }
	end
	despawn(player)
	local slot = freeSlot()
	slots[slot] = player
	local origin = Config.LEVEL_ORIGIN + Vector3.new(0, 0, (slot - 1) * Config.LEVEL_SPACING)
	local built = LevelBuilder.build(lv, origin, levelsFolder, false)
	built.folder.Name = player.Name .. "_nivel" .. index
	local car = spawnCar(player, built.startCF)
	states[player] = { mode = "level", index = index, slot = slot, level = built, car = car, startTime = os.clock(), over = false }
	-- Se envían nombres (no objetos): el cliente espera a que le lleguen con WaitForChild.
	return {
		ok = true, mode = "level", index = index, name = lv.name, hint = lv.hint, par = lv.par,
		carName = car.Name, levelName = built.folder.Name,
		targetCF = built.target.CFrame, targetHW = built.targetHW, targetHL = built.targetHL,
		god = p.god,
	}
end

local function startCity(player)
	despawn(player)
	local cf = city.startCF + Vector3.new(math.random(-3, 3) * S, 0, 0)
	local car = spawnCar(player, cf)
	states[player] = { mode = "city", car = car }
	return { ok = true, mode = "city", carName = car.Name, hint = GameData.CITY.hint }
end

local function levelDone(player, index)
	local st = states[player]
	local p = profiles[player]
	if not st or st.mode ~= "level" or st.index ~= index or st.over then return { ok = false } end
	-- Comprobación en el servidor: el coche tiene que estar de verdad en la plaza.
	local chassis = st.car and st.car.PrimaryPart
	if not chassis then return { ok = false } end
	local spec = GameData.CARS[st.car:GetAttribute("CarKey")]
	local tol = 1.5
	local inside = Physics.parkedIn(chassis.CFrame, spec.w * S / 2 - tol, spec.l * S / 2 - tol, st.level.target.CFrame, st.level.targetHW, st.level.targetHL)
	local elapsed = os.clock() - st.startTime
	if not inside or elapsed < 2 then return { ok = false, error = "No estás aparcado en la plaza" } end
	st.over = true
	local par = GameData.LEVELS[index].par
	local stars = 1
	if elapsed <= par then stars = 3 elseif elapsed <= par * 1.6 then stars = 2 end
	local first = starsOf(p, index) == 0
	local reward = (first and (100 + (index - 1) * 25) or 20) + stars * 20
	p.stars[tostring(index)] = math.max(starsOf(p, index), stars)
	p.coins = p.coins + reward
	changed(player)
	return { ok = true, stars = stars, reward = reward, time = elapsed, hasNext = GameData.LEVELS[index + 1] ~= nil }
end

-- ---------- Monedas de la ciudad ----------
local coinTakenAt = {}
local function collectCoin(player, id)
	local st = states[player]
	local coin = city.coins[id]
	if not st or st.mode ~= "city" or not coin or coinTakenAt[id] then return { ok = false } end
	local chassis = st.car and st.car.PrimaryPart
	if not chassis or (chassis.Position - coin.Position).Magnitude > 4 * S then return { ok = false } end
	coinTakenAt[id] = os.clock()
	coin.Transparency = 1
	coinTaken:FireAllClients(id, true)
	profiles[player].coins = profiles[player].coins + Config.CITY_COIN_VALUE
	changed(player)
	task.delay(Config.COIN_RESPAWN_SECONDS, function()
		coinTakenAt[id] = nil
		coin.Transparency = 0
		coinTaken:FireAllClients(id, false)
	end)
	return { ok = true }
end

-- ---------- Garaje y taller ----------
local function validPart(cat, id)
	local t = GameData.TUNING[cat]
	if not t then return nil end
	for _, o in ipairs(t.options) do
		if o.id == id then return o end
	end
	return nil
end

-- Piezas disponibles en la versión de Roblox (alerones y body kits: próximamente).
local ROBLOX_PARTS = { rims = true, height = true, neon = true }

local actions = {}

function actions.profile(player)
	return publicProfile(player)
end

function actions.play(player, args)
	if args.mode == "city" then return startCity(player) end
	return startLevel(player, tonumber(args.index) or 1)
end

function actions.levelDone(player, args)
	return levelDone(player, tonumber(args.index))
end

function actions.levelFail(player, args)
	local st = states[player]
	if st and st.mode == "level" and not profiles[player].god then st.over = true end
	return { ok = true }
end

function actions.exit(player)
	despawn(player)
	return { ok = true }
end

function actions.buy(player, args)
	local p = profiles[player]
	local car = GameData.CARS[args.car]
	if not car then return { ok = false } end
	if contains(p.owned, args.car) then return { ok = true } end
	if p.coins < car.price then return { ok = false, error = "Te faltan " .. (car.price - p.coins) .. " monedas" } end
	p.coins = p.coins - car.price
	table.insert(p.owned, args.car)
	p.car = args.car
	changed(player)
	return { ok = true }
end

function actions.select(player, args)
	local p = profiles[player]
	if not contains(p.owned, args.car) then return { ok = false } end
	p.car = args.car
	changed(player)
	return { ok = true }
end

function actions.color(player, args)
	if not contains(GameData.COLORS, args.color) then return { ok = false } end
	profiles[player].color = args.color
	changed(player)
	return { ok = true }
end

function actions.part(player, args)
	local p = profiles[player]
	local o = validPart(args.cat, args.id)
	if not o or not ROBLOX_PARTS[args.cat] or not contains(p.owned, args.car) then return { ok = false } end
	local tag = args.car .. ":" .. args.cat .. ":" .. args.id
	if o.price > 0 and not contains(p.parts, tag) then
		if p.coins < o.price then return { ok = false, error = "Te faltan " .. (o.price - p.coins) .. " monedas" } end
		p.coins = p.coins - o.price
		table.insert(p.parts, tag)
	end
	p.tuning[args.car] = p.tuning[args.car] or {}
	p.tuning[args.car][args.cat] = args.id
	changed(player)
	return { ok = true }
end

function actions.admin(player, args)
	if not isAdmin(player) then return { ok = false, error = "No eres administrador" } end
	local p = profiles[player]
	local a = args.action
	if a == "coins" then
		p.coins = math.min(p.coins + math.clamp(tonumber(args.amount) or 0, 0, 1000000), 999999999)
	elseif a == "million" then
		p.coins = 1000000
	elseif a == "cars" then
		p.owned = {}
		for _, k in ipairs(GameData.CAR_ORDER) do table.insert(p.owned, k) end
	elseif a == "parts" then
		p.parts = {}
		for _, k in ipairs(GameData.CAR_ORDER) do
			for cat in pairs(ROBLOX_PARTS) do
				for _, o in ipairs(GameData.TUNING[cat].options) do table.insert(p.parts, k .. ":" .. cat .. ":" .. o.id) end
			end
		end
	elseif a == "levels" then
		for i = 1, #GameData.LEVELS do p.stars[tostring(i)] = 3 end
	elseif a == "god" then
		p.god = not p.god
	elseif a == "reset" then
		local fresh = defaultProfile()
		for k, v in pairs(fresh) do p[k] = v end
	else
		return { ok = false }
	end
	changed(player)
	return { ok = true }
end

-- Límite de peticiones por jugador para evitar abusos.
local lastRequest = {}
request.OnServerInvoke = function(player, action, args)
	if not profiles[player] then return { ok = false, error = "Cargando partida..." } end
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 0.08 and action ~= "profile" then return { ok = false } end
	lastRequest[player] = now
	local fn = actions[action]
	if type(fn) ~= "function" then return { ok = false } end
	local ok, result = pcall(fn, player, type(args) == "table" and args or {})
	if not ok then
		warn("Error en la acción " .. tostring(action) .. ": " .. tostring(result))
		return { ok = false, error = "Error del servidor" }
	end
	return result
end

-- ---------- Entrada y salida de jugadores ----------
local function onPlayerAdded(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Monedas"
	coins.Parent = ls
	ls.Parent = player
	profiles[player] = load(player)
	changed(player)
	player.CharacterAdded:Connect(function(character)
		local hum = character:WaitForChild("Humanoid")
		hum.Died:Connect(function() despawn(player) end)
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(onPlayerAdded, player) end

Players.PlayerRemoving:Connect(function(player)
	despawn(player)
	save(player)
	profiles[player] = nil
	lastRequest[player] = nil
end)

-- Guardado automático cada minuto y al cerrar el servidor.
task.spawn(function()
	while true do
		task.wait(60)
		for player in pairs(profiles) do save(player) end
	end
end)
game:BindToClose(function()
	for player in pairs(profiles) do save(player) end
end)
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX0000000C"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000B"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000A"><Properties><string name="Name">ParkingClient</string><ProtectedString name="Source"><![CDATA[-- Cliente de Parking Pro 3D: interfaz, controles, conducción, cámara y sonido.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("ParkingShared")
local Config = require(Shared:WaitForChild("Config"))
local GameData = require(Shared:WaitForChild("GameData"))
local Physics = require(Shared:WaitForChild("Physics"))
local CarBuilder = require(Shared:WaitForChild("CarBuilder"))
local remotes = ReplicatedStorage:WaitForChild("ParkingRemotes")
local request = remotes:WaitForChild("Request")

local S = Config.SCALE
local clamp = Physics.clamp
local profile = nil

-- ===================== Interfaz =====================
local T = {
	bg = Color3.fromRGB(18, 21, 28), panel = Color3.fromRGB(28, 33, 43), button = Color3.fromRGB(48, 56, 70),
	accent = Color3.fromRGB(255, 180, 0), text = Color3.fromRGB(244, 246, 251), muted = Color3.fromRGB(165, 173, 189),
	ok = Color3.fromRGB(34, 197, 94), bad = Color3.fromRGB(239, 68, 68), dark = Color3.fromRGB(26, 19, 0),
}

local function make(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

local function round(inst, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 12), Parent = inst })
	return inst
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or T.text
	props.TextSize = props.TextSize or 18
	return make("TextLabel", props)
end

local function button(text, props)
	props = props or {}
	props.Text = text
	props.Font = props.Font or Enum.Font.GothamBlack
	props.TextSize = props.TextSize or 18
	props.TextColor3 = props.TextColor3 or T.text
	props.BackgroundColor3 = props.BackgroundColor3 or T.button
	props.AutoButtonColor = true
	local b = make("TextButton", props)
	round(b, 12)
	make("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.85, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
	return b
end

local function panel(props)
	props.BackgroundColor3 = props.BackgroundColor3 or T.panel
	props.BackgroundTransparency = props.BackgroundTransparency or 0.08
	local f = make("Frame", props)
	round(f, 18)
	return f
end

local gui = make("ScreenGui", { Name = "ParkingUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })

local toastLabel = label({ Size = UDim2.fromOffset(420, 44), Position = UDim2.new(0.5, -210, 0.3, 0), BackgroundTransparency = 0.15, BackgroundColor3 = T.panel, TextSize = 20, Visible = false, ZIndex = 50, Parent = gui })
round(toastLabel, 12)
local toastToken = 0
local function toast(msg)
	toastToken = toastToken + 1
	local mine = toastToken
	toastLabel.Text = msg
	toastLabel.Visible = true
	task.delay(1.8, function()
		if toastToken == mine then toastLabel.Visible = false end
	end)
end

local function call(action, args)
	local ok, res = pcall(function() return request:InvokeServer(action, args or {}) end)
	if not ok or type(res) ~= "table" then return { ok = false, error = "Sin conexión con el servidor" } end
	if res.ok == false and res.error then toast(res.error) end
	return res
end

local function formatCoins(n)
	local s = tostring(math.floor(n or 0))
	local out = ""
	while #s > 3 do
		out = "." .. string.sub(s, -3) .. out
		s = string.sub(s, 1, -4)
	end
	return "🪙 " .. s .. out
end

local screens = {}
local function show(name)
	for k, f in pairs(screens) do f.Visible = (k == name) end
end

-- ---------- Menú principal ----------
local menu = panel({ Name = "Menu", Size = UDim2.fromOffset(560, 250), Position = UDim2.new(0.5, -280, 1, -270), Parent = gui })
screens.menu = menu
label({ Text = "PARKING PRO 3D", Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 10), Font = Enum.Font.GothamBlack, TextSize = 46, TextColor3 = T.accent, Parent = menu })
label({ Text = "Aparca sin chocar. ¿Eres el mejor conductor?", Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 68), TextColor3 = T.muted, TextSize = 16, Font = Enum.Font.Gotham, Parent = menu })
local menuCoins = label({ Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 96), TextSize = 20, Parent = menu })
local menuRow = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -40, 0, 110), Position = UDim2.fromOffset(20, 130), Parent = menu })
make("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 48), CellPadding = UDim2.fromOffset(12, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = menuRow })
local btnLevels = button("▶ Niveles", { LayoutOrder = 1, BackgroundColor3 = T.accent, TextColor3 = T.dark, Parent = menuRow })
local btnCity = button("🏙️ Ciudad libre", { LayoutOrder = 2, Parent = menuRow })
local btnGarage = button("🚗 Garaje", { LayoutOrder = 3, Parent = menuRow })
local btnAdmin = button("🛠️ Admin", { LayoutOrder = 4, Visible = false, Parent = menuRow })

-- ---------- Niveles ----------
local levelsScreen = panel({ Name = "Levels", Size = UDim2.new(0, 760, 0, 420), Position = UDim2.new(0.5, -380, 0.5, -210), Visible = false, Parent = gui })
screens.levels = levelsScreen
label({ Text = "Niveles", Size = UDim2.new(1, 0, 0, 50), TextSize = 30, Font = Enum.Font.GothamBlack, Parent = levelsScreen })
local levelsBack = button("← Volver", { Size = UDim2.fromOffset(120, 40), Position = UDim2.fromOffset(14, 8), TextSize = 16, Parent = levelsScreen })
